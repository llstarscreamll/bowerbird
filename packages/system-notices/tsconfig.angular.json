{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "tslib": ["node_modules/tslib"]
    }
  },
  "include": ["src/angular/**/*.ts", "src/lib/**/*.ts"]
}
