app.bowerbird.dev {
	tls internal
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: https:; connect-src 'self' https://api.bowerbird.dev; frame-src 'self' blob:; form-action 'self'"
		# HMR uses wss://app.bowerbird.dev ('self'); trust Caddy's local CA — do not allow localhost fallbacks.
	}
	reverse_proxy 127.0.0.1:4200
}

api.bowerbird.dev {
	tls internal
	reverse_proxy 127.0.0.1:8080
}

media.bowerbird.dev {
	tls internal
	reverse_proxy 127.0.0.1:4566
}
