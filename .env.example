# Backend / local onprem
PORT=8080
DEPLOYMENT_TARGET=onprem
DEFAULT_TENANT_SLUG=acme
APP_ENV=local
DATABASE_URL=postgres://bowerbird:bowerbird@localhost:5432/bowerbird?sslmode=disable
RABBITMQ_URL=amqp://bowerbird:bowerbird@localhost:5672/
MINIO_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=bowerbird
AWS_SECRET_ACCESS_KEY=bowerbirdsecret
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
S3_BUCKET_NAME=bowerbird-local-bucket
S3_PRESIGN_ENDPOINT_URL=https://media.bowerbird.dev
ALLOWED_ORIGINS=https://app.bowerbird.dev,http://app.bowerbird.dev,http://localhost:4200
FRONTEND_URL=https://app.bowerbird.dev
BACKEND_URL=https://api.bowerbird.dev
GEMINI_API_KEY=dummy-gemini-api-key
# Local-only example keys. Generate unique values for non-local deploys: openssl rand -base64 32
INBOX_CREDENTIALS_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
TENANT_SECRETS_ENCRYPTION_KEY=Ym93ZXJiaXJkLWxvY2FsLXNlY3JldHMta2V5LTMyYiE=
MESSAGING_ATTESTATION_SECRET=local-dev-messaging-attestation-secret
# Optional: override temp dir for zip staging (defaults to TMPDIR or OS temp)
# BOWERBIRD_WORK_TEMP_DIR=/tmp/bowerbird-work
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Infra (CDK)
ENV=prod
AWS_ACCOUNT_ID=123456789012
ROOT_DOMAIN=money-path.co
APP_SUBDOMAIN=app
API_SUBDOMAIN=api

# E2E (optional)
# E2E_BASE_URL=https://app.bowerbird.dev
# E2E_API_BASE_URL=https://api.bowerbird.dev
