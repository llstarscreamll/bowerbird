# Backend / local onprem
PORT=8080
DEPLOYMENT_TARGET=onprem
APP_ENV=local
DATABASE_URL=postgres://bowerbird:bowerbird@localhost:5432/bowerbird?sslmode=disable
RABBITMQ_URL=amqp://bowerbird:bowerbird@localhost:5672/
MINIO_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=bowerbird
AWS_SECRET_ACCESS_KEY=bowerbirdsecret
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
S3_BUCKET_NAME=bowerbird-local-bucket
S3_PRESIGN_ENDPOINT_URL=https://media.bowerbird.dev
ALLOWED_ORIGINS=https://app.bowerbird.dev,http://app.bowerbird.dev,http://localhost:4200
FRONTEND_URL=https://app.bowerbird.dev
BACKEND_URL=https://app.bowerbird.dev
GEMINI_API_KEY=dummy-gemini-api-key
# Local-only example keys. Generate unique values for non-local deploys: openssl rand -base64 32
INBOX_CREDENTIALS_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
TENANT_SECRETS_ENCRYPTION_KEY=Ym93ZXJiaXJkLWxvY2FsLXNlY3JldHMta2V5LTMyYiE=
MESSAGING_ATTESTATION_SECRET=local-dev-messaging-attestation-secret
# Optional: override temp dir for zip staging (defaults to TMPDIR or OS temp)
# BOWERBIRD_WORK_TEMP_DIR=/tmp/bowerbird-work
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# On-prem fleet (Pulumi SSH + Docker Compose — apps/deploy/onprem)
# Copy hosts.example.json → hosts.json (gitignored). Skip the fleet if unset.
# ONPREM_HOSTS_FILE=apps/deploy/onprem/hosts.json
# ONPREM_SSH_KEY_PATH=/path/to/id_ed25519
# ONPREM_RELEASE=

# Infra (Pulumi / AWS Lambda — apps/deploy/aws)
# Do not run `pnpm run deploy:aws` with the MinIO dummy keys above.
# Use ENV_FILE=.env.aws (omit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# so the SDK uses SSO or ~/.aws/credentials) or an AWS_PROFILE.
ENV=prod
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
ROOT_DOMAIN=money-path.co
APP_SUBDOMAIN=app
MEDIA_SUBDOMAIN=media
API_ORIGIN_SUBDOMAIN=api
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
# Existing project id from the Neon Console. Pulumi does not create or delete it.
NEON_PROJECT_ID=
# GEMINI_MODEL=gemini-2.0-flash
# ALARM_EMAIL=ops@example.com

# E2E (Playwright). Unset = local (*.bowerbird.dev). Point these at staging or
# production to run the same suite against that environment.
# E2E_BASE_URL=https://app.bowerbird.dev
# E2E_API_BASE_URL=https://app.bowerbird.dev
# E2E_MEDIA_BASE_URL=https://media.bowerbird.dev
