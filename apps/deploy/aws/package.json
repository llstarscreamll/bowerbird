{
  "name": "@bowerbird/infra",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:lambdas": "bash ./scripts/build-lambdas.sh",
    "build": "pnpm run build:lambdas && tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types src/config.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "synth": "pnpm run build:lambdas && pulumi preview",
    "deploy": "pnpm run build:lambdas && pulumi stack select \"$ENV\" && pulumi up --yes",
    "migrate": "pulumi stack output migrateFunctionName | xargs -I{} aws lambda invoke --function-name {} /tmp/bowerbird-migrate.json && cat /tmp/bowerbird-migrate.json"
  },
  "dependencies": {
    "@pulumi/aws": "^6.83.0",
    "@pulumi/cloudflare": "^5.49.1",
    "@pulumi/neon": "workspace:*",
    "@pulumi/pulumi": "^3.238.0",
    "@pulumi/random": "^4.18.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.7.2"
  }
}
