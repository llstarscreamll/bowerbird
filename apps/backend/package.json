{
  "name": "@bowerbird/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "[ -f ../../.env ] && set -a && . ../../.env && set +a; exec air -c .air.toml",
    "dev:relay": "[ -f ../../.env ] && set -a && . ../../.env && set +a; exec air -c .air.worker-relay.toml",
    "dev:events-consumer": "[ -f ../../.env ] && set -a && . ../../.env && set +a; exec air -c .air.worker-events.toml",
    "dev:jobs-consumer": "[ -f ../../.env ] && set -a && . ../../.env && set +a; exec air -c .air.worker-jobs.toml",
    "dev:scheduler": "[ -f ../../.env ] && set -a && . ../../.env && set +a; exec air -c .air.worker-scheduler.toml",
    "seed": "set -a && . ../../.env && set +a && go run ./cmd/seed",
    "build": "mkdir -p bin && go build -o bin/api ./cmd/api && go build -o bin/worker ./cmd/worker && go build -o bin/lambda-http ./cmd/lambda/http && go build -o bin/lambda-sqs ./cmd/lambda/sqs && go build -o bin/lambda-eventbridge ./cmd/lambda/eventbridge && go build -o bin/lambda-outbox-relay ./cmd/lambda/outbox-relay && go build -o bin/migrate ./cmd/migrate && go build -o bin/seed ./cmd/seed",
    "migrate:controlplane": "set -a && . ../../.env && set +a && ./bin/migrate -target controlplane",
    "migrate:tenants": "set -a && . ../../.env && set +a && ./bin/migrate -target tenants",
    "migrate:all": "set -a && . ../../.env && set +a && go run ./cmd/migrate -target all",
    "test": "[ -f ../../.env ] && set -a && . ../../.env && set +a; go test ./...",
    "lint": "go vet ./..."
  }
}
