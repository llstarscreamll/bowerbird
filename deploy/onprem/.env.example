RABBITMQ_URL=amqp://bowerbird:bowerbird@rabbitmq:5672/
MINIO_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=bowerbird
AWS_SECRET_ACCESS_KEY=bowerbirdsecret
AWS_REGION=us-east-1
S3_BUCKET_NAME=bowerbird
S3_PRESIGN_ENDPOINT_URL=http://minio:9000
GEMINI_API_KEY=replace-me
INBOX_CREDENTIALS_ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
TENANT_SECRETS_ENCRYPTION_KEY=Ym93ZXJiaXJkLWxvY2FsLXNlY3JldHMta2V5LTMyYiE=
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
# Writable temp dir for zip staging/extraction in jobs-consumer (see docker-compose volume)
BOWERBIRD_WORK_TEMP_DIR=/var/lib/bowerbird/work-tmp
